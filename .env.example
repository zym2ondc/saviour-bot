# --- REQUIRED ---
DISCORD_TOKEN=paste-your-bot-token-here
CLIENT_ID=paste-your-application-client-id-here
# Optional: single server ID for testing. Leave EMPTY = bot auto-deploys instantly to every server it's in (no GUILD_ID needed).
GUILD_ID=paste-your-server-id-here

# --- OPTIONAL (ticket config) ---
# Category ID where ticket channels get created. Right-click category -> Copy ID. Leave empty = creates at top.
TICKET_CATEGORY_ID=
# Staff role ID that can see all tickets. Leave empty = only user + admins can see.
TICKET_STAFF_ROLE_ID=
# Log channel ID where bot posts "ticket created/closed". Leave empty = no logs.
TICKET_LOG_CHANNEL_ID=

# --- VERIFY / RESTORE (OAuth2) ---
# Get from Discord Developer Portal -> your app -> OAuth2 -> Client Secret (Reset Secret to see it)
CLIENT_SECRET=paste-client-secret-here
# Must EXACTLY match a Redirect URL you add in Portal -> OAuth2 -> Redirects
# For local test: http://localhost:3000/callback
# For real use (members on other PCs): https://your-public-url/callback  (use ngrok / Railway / VPS)
OAUTH_REDIRECT_URI=http://localhost:3000/callback
PORT=3000
# Optional role given after verify (right-click role -> Copy ID)
VERIFIED_ROLE_ID=
UNVERIFIED_ROLE_ID=
